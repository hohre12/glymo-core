{
  "name": "@glymo/core",
  "version": "0.19.0",
  "description": "Hand-powered creative toolkit for the browser. Hand tracking + artistic effects + gesture control in one library.",
  "type": "module",
  "main": "./dist/glymo.js",
  "module": "./dist/glymo.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glymo.mjs",
      "require": "./dist/glymo.js"
    },
    "./classifier": {
      "types": "./dist/classifier/index.d.ts",
      "import": "./dist/classifier/classifier.mjs",
      "require": "./dist/classifier/classifier.js"
    },
    "./classifier/classifier.worker.js": "./dist/classifier/classifier.worker.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:library && npm run build:worker",
    "build:library": "BUILD_TARGET=library vite build",
    "build:worker": "BUILD_TARGET=worker vite build",
    "dev": "BUILD_TARGET=library vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:env-staged": "node scripts/check-env-staged.mjs",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@hookform/resolvers": "^5.2.2",
    "gifenc": "^1.0.3",
    "motion": "^12.38.0",
    "phosphor-react": "^1.4.1",
    "react-hook-form": "^7.72.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^0.10.34",
    "@napi-rs/canvas": "^0.1.97",
    "@types/jsdom": "^28.0.1",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.183.1",
    "@vitest/coverage-v8": "^3.0",
    "@webgpu/types": "^0.1.69",
    "canvas": "^3.2.3",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "onnxruntime-web": "^1.24.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "three": "^0.183.2",
    "typescript": "^5.7",
    "vite": "^8.0",
    "vite-plugin-dts": "^4.0",
    "vitest": "^3.0"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": ">=0.10.0",
    "onnxruntime-web": "^1.24.0",
    "tesseract.js": "^5.0.0",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "@mediapipe/tasks-vision": {
      "optional": true
    },
    "onnxruntime-web": {
      "optional": true
    },
    "tesseract.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hohre12/glymo-core.git"
  },
  "homepage": "https://glymo.app",
  "bugs": {
    "url": "https://github.com/hohre12/glymo-core/issues"
  },
  "keywords": [
    "hand-tracking",
    "handwriting",
    "drawing",
    "canvas",
    "effects",
    "smoothing",
    "calligraphy",
    "neon",
    "particles",
    "pipeline",
    "creative",
    "gesture",
    "mediapipe",
    "kinetic-typography",
    "webcam"
  ],
  "engines": {
    "node": ">=18"
  }
}
